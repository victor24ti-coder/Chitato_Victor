<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/surface_canvas">

    <!-- Ikon centang -->
    <TextView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:text="✓"
        android:textSize="56sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/bg_success_circle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Registrasi Berhasil!"
        android:textColor="@color/brand_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Akun Anda telah berhasil dibuat.\nSilakan login untuk melanjutkan."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <Button
        android:id="@+id/btnGoLogin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/brand_primary"
        android:text="Masuk Sekarang"
        android:textColor="@color/white"
        android:textSize="15sp" />

</LinearLayout>
